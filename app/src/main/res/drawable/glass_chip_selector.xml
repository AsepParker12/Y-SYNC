<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <corners android:radius="14dp" />
                <solid android:color="#7C3AED" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <corners android:radius="14dp" />
                <solid android:color="@color/glass_card_solid" />
                <stroke android:width="1dp" android:color="@color/glass_nav_stroke" />
            </shape>
        </inset>
    </item>
</selector>
