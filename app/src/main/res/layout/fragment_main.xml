<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <org.schabi.newpipe.views.ScrollableTabLayout
        android:id="@+id/main_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:tabBackground="@drawable/glass_chip_selector"
        app:tabRippleColor="@android:color/transparent"
        app:tabIconTint="@color/glass_chip_text"
        app:tabTextColor="@color/glass_chip_text"
        app:tabIndicatorHeight="0dp"
        app:tabGravity="fill"
        app:tabMinWidth="60dp" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/main_tab_layout" />

</RelativeLayout>
